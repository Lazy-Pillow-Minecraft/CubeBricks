{
  "name": "cubebricks",
  "version": "0.1.0",
  "description": "A modular Minecraft modelling workspace built around cubes and procedural shapes.",
  "author": "CubeBricks",
  "productName": "CubeBricks",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "start:safe": "set CUBEBRICKS_SOFTWARE_RENDERING=1&& electron .",
    "preview": "node scripts/preview-server.cjs",
    "dev": "electron .",
    "check": "node scripts/check-sources.mjs",
    "i18n:extract": "node scripts/extract-ui-text.mjs",
    "test:color-space": "node scripts/test-color-space-gradient.mjs && node scripts/test-color-map-file.mjs",
    "test:layer-tone-map": "node scripts/test-layer-tone-map.mjs && node scripts/test-layer-mask.mjs",
    "test:modules": "node scripts/test-editor-modules.mjs",
    "test:config": "node scripts/test-config-registry.mjs",
    "test:model": "node scripts/test-model-groups.mjs",
    "test:shape-packs": "node scripts/test-shape-packs.mjs",
    "test:resource-packs": "node scripts/test-resource-packs.mjs",
    "test:render": "node scripts/test-render-uv.mjs && node scripts/test-vertex-intersections.mjs && node scripts/test-paint-explode.mjs",
    "test:paint-selection": "node scripts/test-paint-selection.mjs",
    "test:journal": "node --test scripts/test-project-journal.cjs scripts/test-texture-delta.cjs scripts/test-journal-ownership.cjs scripts/test-renderer-journal.cjs scripts/test-journal-ipc.cjs",
    "test:operations": "node --test scripts/test-operation-registry.mjs",
    "dist:portable": "node scripts/build-portable.cjs"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cubebricks.desktop",
    "directories": {
      "buildResources": "src/assets",
      "output": "dist"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "artifactName": "CubeBricks-${version}-portable.${ext}",
    "win": {
      "icon": "src/assets/shortcut-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "src/assets/shortcut-icon.png"
    },
    "linux": {
      "icon": "src/assets/shortcut-icon.png"
    }
  }
}
